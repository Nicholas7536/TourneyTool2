{
  "name": "strikers-tournament-simulator",
  "version": "1.0.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config vite.config.ts",
    "serve": "tsx server/index.ts",
    "start": "pnpm run serve",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "mongodb": "^6.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}
